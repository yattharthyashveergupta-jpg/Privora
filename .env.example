# =================================================================
# Privora — Environment Configuration Template (.env.example)
# Zero real secrets. Copy to .env or set environment variables.
# =================================================================

# -----------------------------------------------------------------
# 1. Frontend Configuration (Next.js)
# -----------------------------------------------------------------
# Base URL for the Privora FastAPI backend API.
# In local desktop mode or default setup, defaults to http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------
# 2. Local AI & Inference Engine (Ollama)
# -----------------------------------------------------------------
# URL of the local Ollama instance running on the same host.
# PRIVORA NEVER CONNECTS TO EXTERNAL/CLOUD AI APIS.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Primary local LLM for evidence synthesis and RAG QA.
# Recommended: qwen2.5:7b (or qwen2.5:3b / qwen2.5:1.5b on lower VRAM hosts)
OLLAMA_MODEL=qwen2.5:7b

# Multimodal Visual Language Model for Visual QA on diagrams and charts.
# Recommended: moondream:latest
OLLAMA_VISION_MODEL=moondream:latest

# -----------------------------------------------------------------
# 3. Server & Network Binding
# -----------------------------------------------------------------
# Bind exclusively to 127.0.0.1 for local/desktop air-gapped security.
HOST=127.0.0.1
PORT=8000

# Deployment mode: 'local' (single-user desktop/workstation) or 'server' (multi-user RBAC)
DEPLOYMENT_MODE=local

# Allowed CORS origins for browser security (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# -----------------------------------------------------------------
# 4. Storage & Storage Enclave
# -----------------------------------------------------------------
# Optional custom data directory for SQLite database and uploaded documents.
# Default on Windows Desktop: %LOCALAPPDATA%\Privora\data
# Default in source/Linux: backend/data
# WORKBENCH_DATA_DIR=backend/data

# -----------------------------------------------------------------
# 5. Security & Session Settings (Server Mode Only)
# -----------------------------------------------------------------
# Cookie security flag: true for HTTPS in production, false for local HTTP
COOKIE_SECURE=false

# Session duration in days
SESSION_DURATION_DAYS=7
