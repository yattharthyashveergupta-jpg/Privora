# ==============================================================================
# Privora — Enterprise Server Mode Environment Variables
# Copy this file to .env.server and customize values for production deployment.
# ==============================================================================

# Core Deployment Mode (Must be 'server' for enterprise multi-user deployments)
DEPLOYMENT_MODE=server

# Secret Key used for session token signing and state integrity
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
PRIVORA_SECRET_KEY=change_me_to_a_cryptographically_secure_random_64_char_hex_string

# Trusted Allowed Origins for Cross-Origin Resource Sharing (CORS)
# Multiple origins may be comma-delimited. NEVER set to '*' in server mode!
CORS_ORIGINS=https://privora.yourcompany.internal,https://workbench.internal

# Ollama Inference Engine Base URL
# If running via docker-compose, this connects to the internal container 'ollama'
OLLAMA_BASE_URL=http://ollama:11434

# Primary Default Model for Document Intelligence
# Options: qwen2.5:7b, llama3.1:8b, mistral:7b, deepseek-r1:8b
PRIVORA_MODEL=qwen2.5:7b

# Data Storage Directories
DATA_DIR=/app/data
DATABASE_PATH=/app/data/workbench.sqlite3
STATIC_DIR=/app/static

# Cookie Security & SSL Configuration
# Set to 'true' in production behind HTTPS reverse proxy
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Rate Limiting Configuration
# Limits the maximum failed login attempts per IP per minute
AUTH_RATE_LIMIT_PER_MINUTE=5

# Audit Logging Configuration
# Retention period for tamper-evident audit logs in days
AUDIT_LOG_RETENTION_DAYS=365

# Backup Configuration
# Daily automated backup retention count
BACKUP_MAX_ARCHIVES=30
